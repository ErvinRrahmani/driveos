{
  "name": "@driveos/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names api,worker --prefix-colors blue,magenta \"pnpm:dev:api\" \"pnpm:dev:worker\"",
    "dev:api": "node --watch --import @swc-node/register/esm-register src/main.ts",
    "dev:worker": "node --watch --import @swc-node/register/esm-register src/worker.ts",
    "openapi:emit": "node --import @swc-node/register/esm-register src/openapi-emit.ts",
    "generate": "pnpm run openapi:emit",
    "db:bootstrap": "node --import @swc-node/register/esm-register scripts/db/bootstrap.ts",
    "db:migrate": "node --import @swc-node/register/esm-register scripts/db/migrate.ts",
    "db:reset": "node --import @swc-node/register/esm-register scripts/db/reset.ts",
    "db:seed": "node --import @swc-node/register/esm-register scripts/db/seed.ts",
    "db:generate": "drizzle-kit generate",
    "load:booking": "node --import @swc-node/register/esm-register scripts/load/booking-contention.ts",
    "load:relay": "node --import @swc-node/register/esm-register scripts/load/relay-throughput.ts",
    "question-bank:import": "node --import @swc-node/register/esm-register scripts/question-bank/import.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@driveos/shared": "workspace:^",
    "@nestjs/common": "^12",
    "@nestjs/config": "^12",
    "@nestjs/core": "^12",
    "@nestjs/cqrs": "^12",
    "@nestjs/platform-express": "^12",
    "@nestjs/swagger": "^12",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.3",
    "http-status-codes": "^2.3.0",
    "i18next": "^26",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "pino": "^10",
    "pino-http": "^11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@driveos/eslint-config": "workspace:^",
    "@nestjs/testing": "^12",
    "@swc-node/register": "^1.12",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2",
    "vitest": "^5"
  }
}
