{
  "name": "@driveos/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./mocks": {
      "types": "./src/mocks/index.ts",
      "default": "./src/mocks/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "generate": "openapi-typescript ../../apps/api/openapi.json --output src/client/generated/schema.d.ts && node scripts/generate-mocks.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "http-status-codes": "^2.3.0",
    "msw": "^2.15.0",
    "openapi-fetch": "^0.17",
    "openapi-react-query": "^0.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@driveos/eslint-config": "workspace:^",
    "@tanstack/react-query": "^5.104",
    "@types/node": "^24",
    "eslint": "^10",
    "openapi-typescript": "^7.13",
    "typescript": "~6.0.3",
    "vitest": "^5"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104"
  }
}
